<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyz.maoyan.mapper.TypeMapper">
    <select id="getTypeList" resultType="com.cyz.maoyan.entity.Type">
        select * from type where del = 0
    </select>
    <select id="getTypeListByFilmId" resultType="com.cyz.maoyan.entity.Type">
        select *
        from type
        where id in (select type_id from film_types where film_id = #{id})
    </select>
</mapper>
